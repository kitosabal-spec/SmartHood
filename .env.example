# Application
NODE_ENV=production
PORT=3000
APP_NAME=SmartHood
APP_BASE_URL=https://your-smarthood-domain.example
SESSION_SECRET=replace-with-a-long-random-value
FILE_ACCESS_SECRET=replace-with-a-different-long-random-value
# Required only when initializing a new database; use a unique password (12+ characters).
INITIAL_ADMIN_PASSWORD=
# Real first administrator address; verify it using admin:enroll-email or the
# login page's Register administrator email flow. Never used to overwrite an existing account.
INITIAL_ADMIN_EMAIL=

# Authentication protection. Render: nearest ingress hop only; direct hosting: 0.
# Verify the ingress topology before changing TRUST_PROXY; never use true.
TRUST_PROXY=1
LOGIN_RATE_WINDOW_MS=900000
LOGIN_IDENTIFIER_MAX_FAILURES=8
LOGIN_WARNING_AFTER_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_SECURITY_EMAIL_ENABLED=true
LOGIN_SECURITY_EMAIL_COOLDOWN_MS=900000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=smarthood_app
MYSQL_PASSWORD=
MYSQL_DATABASE=san_alfonso_homes
MYSQL_SSL=false
# Local bootstrap only. Keep false in production and provision the database
# with a separate administrator account.
MYSQL_CREATE_DATABASE=false
# Production: enable certificate verification. Set this when the database CA
# is private or is not already trusted by the operating system.
MYSQL_SSL_CA_PATH=

# Development-only escape hatch. Never enable in production.
ALLOW_DESTRUCTIVE_RESET=false

# Transactional email (SMTP)
# For Gmail, SMTP_PASS must be a Google App Password, not the account password.
# For production, a transactional provider such as Postmark, Resend SMTP, Amazon
# SES, Mailgun, or SendGrid is preferable to a personal Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="SmartHood <your-sender@gmail.com>"
EMAIL_REPLY_TO=hoa-office@example.com

# Optional transport tuning
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Set to true to turn off outgoing email without changing code.
EMAIL_DISABLED=false

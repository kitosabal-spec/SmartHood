# Application
NODE_ENV=production
PORT=3000
APP_NAME=SmartHood
APP_BASE_URL=https://your-smarthood-domain.example
SESSION_SECRET=replace-with-a-long-random-value
FILE_ACCESS_SECRET=replace-with-a-different-long-random-value

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=san_alfonso_homes
MYSQL_SSL=false

# Transactional email (SMTP)
# For Gmail, SMTP_PASS must be a Google App Password, not the account password.
# For production, a transactional provider such as Postmark, Resend SMTP, Amazon
# SES, Mailgun, or SendGrid is preferable to a personal Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="SmartHood <your-sender@gmail.com>"
EMAIL_REPLY_TO=hoa-office@example.com

# Optional transport tuning
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Set to true to turn off outgoing email without changing code.
EMAIL_DISABLED=false
